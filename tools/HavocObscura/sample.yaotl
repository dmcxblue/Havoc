# Havoc C2 Profile
# Generated by HavocObscura
# Date: %date%
# Target: %target%

Teamserver {
    Host = "0.0.0.0"
    Port = 40056

    Build {
        Compiler64 = "/usr/bin/x86_64-w64-mingw32-gcc"
        Compiler86 = "/usr/bin/i686-w64-mingw32-gcc"
        Nasm       = "/usr/bin/nasm"
    }
}

Operators {
    user "%operator%" {
        Password = "%password%"
    }
}

Demon {
    Sleep  = %sleep%
    Jitter = %jitter%

    TrustXForwardedFor = %trust_xff%

    Injection {
        Spawn64 = "%spawn64%"
        Spawn32 = "%spawn32%"
    }
}

Listeners {
    Http {
        Name         = "%listener_name%"
        Hosts        = [%hosts%]
        HostBind     = "0.0.0.0"
        HostRotation = "round-robin"
        PortBind     = %port_bind%
        PortConn     = %port_conn%
        Secure       = %secure%
        KillDate     = "%kill_date%"
        UserAgent    = "%user_agent%"

        Uris = [
%uris%
        ]

        Headers = [
%headers%
        ]

        Response {
            Headers = [
%response_headers%
            ]
        }
    }
%smb_listener%
}
%service_block%
%webhook_block%
